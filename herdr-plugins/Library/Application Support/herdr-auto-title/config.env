# Auto Title configuration — https://github.com/kryptamine/herdr-auto-title
#
# Auto Title reads this file, not the config dir `herdr plugin list` prints.
# It is read ONCE, at plugin startup: a change lands only after the Herdr
# server restarts (`herdr server stop`, then `herdr`).
#
# Every line below is the default, so this file as it stands changes nothing.
# A variable set in the environment overrides what is written here.

# Log at DEBUG rather than INFO.
#HERDR_AUTO_TITLE_DEBUG=false

# How often the session is read, in milliseconds.
#HERDR_AUTO_TITLE_POLL_MS=500

# Longest title, in columns of the tab bar.
#HERDR_AUTO_TITLE_MAX_LENGTH=50

# Longest branch name a title may carry, in columns. 0 leaves branches out.
#HERDR_AUTO_TITLE_BRANCH_MAX=12

# Put each tab's position in front of its title.
#HERDR_AUTO_TITLE_POSITION=true

# Where tabs renamed by hand are remembered. Defaults to manual-names.json next
# to this file — which is inside this repo, via the stow symlink, hence the
# .gitignore entry. Write any override in full; "~" is not expanded here.
#HERDR_AUTO_TITLE_MANUAL_FILE=/Users/drewjs/Library/Application Support/herdr-auto-title/manual-names.json

# Read an agent's own session transcript when it has not titled its terminal.
# Only Claude Code's transcript is understood so far, and it needs
# `herdr integration install claude` (the sync script keeps that current).
#HERDR_AUTO_TITLE_TRANSCRIPT=true

# Put the agent's name in front of what an agent pane is doing. Turned off, a
# pane whose agent has reported nothing is named after its directory instead.
#HERDR_AUTO_TITLE_AGENT_NAME=true
